%YAML 1.2
---
name: c
file_extensions: [c]
scope: source.c
contexts:
  main:
    - match: '//.*$'
      scope: comment.line
    - match: '/\*'
      push:
        - meta_scope: comment.block
        - match: '\*/'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted
        - match: '\\.'
          scope: constant.character.escape
        - match: '"'
          pop: true
    - match: ''''
      push:
        - meta_scope: string.quoted
        - match: '\\.'
          scope: constant.character.escape
        - match: ''''
          pop: true
    - match: '\b(?:auto|break|case|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|restrict|return|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|_Bool|_Complex|_Atomic)\b'
      scope: keyword.control
    - match: '\b(?:0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function
    - match: '[+*/%=!<>&|^~?:-]+'
      scope: keyword.operator
    - match: '[{}\[\]();,.]'
      scope: punctuation.separator
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type
