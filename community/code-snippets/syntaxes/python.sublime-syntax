%YAML 1.2
---
name: python
file_extensions: [py]
scope: source.python
contexts:
  main:
    - match: '\#.*$'
      scope: comment.line
    - match: '"""'
      push:
        - meta_scope: string.quoted
        - match: '"""'
          pop: true
    - match: ''''''''
      push:
        - meta_scope: string.quoted
        - match: ''''''''
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted
        - match: '\\.'
          scope: constant.character.escape
        - match: '"'
          pop: true
    - match: ''''
      push:
        - meta_scope: string.quoted
        - match: '\\.'
          scope: constant.character.escape
        - match: ''''
          pop: true
    - match: '\b(?:and|as|assert|async|await|break|class|continue|def|del|elif|else|except|False|finally|for|from|global|if|import|in|is|lambda|None|nonlocal|not|or|pass|raise|return|True|try|while|with|yield)\b'
      scope: keyword.control
    - match: '\b(?:0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function
    - match: '[+*/%=!<>&|^~?:-]+'
      scope: keyword.operator
    - match: '[{}\[\]();,.]'
      scope: punctuation.separator
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type
